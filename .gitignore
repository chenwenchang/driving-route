node_modules/
dist/
*.tmp

# Your own routes and screenshots stay on this PC by default: the GitHub repo and
# the Pages site are public, and screenshots come from other people's videos.
# Move routes to the phone with a route pack (editor → 导出 / 导入), or delete
# these lines if you are happy to publish them.
app/data/routes/*
!app/data/routes/demo-loop.json
app/data/media/
app/data/trash/

.claude/settings.local.json

# Tools and downloads for reading what a route video says (scripts/video/text.mjs):
# yt-dlp, Whisper models, downloaded audio and transcripts. scripts/video/data holds the
# cleaned-up words of other people's videos and your route specs, so it stays local too.
.tools/
.cache/
scripts/video/data/
