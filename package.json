{
  "name": "driving-route",
  "version": "0.1.0",
  "private": true,
  "description": "Cambridge driving test route notebook: capture routes from mock-test videos, annotate hazards, view on Android, export to Google Maps / OsmAnd / My Maps.",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "lan": "node server/server.mjs --lan",
    "test": "node --test \"tests/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node server/server.mjs --dir dist --static --port 5174",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "leaflet": "^1.9.4"
  }
}
